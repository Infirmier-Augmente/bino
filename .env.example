# Copie ce fichier en `.env` (ignoré par git) et renseigne tes clés.
# Aucune clé n'est nécessaire pour développer : sans clé, l'IA tourne en moteur
# "heuristic" (règles locales, déterministe), suffisant pour coder et tester.

# ─── Serveur API ────────────────────────────────────────────────────────────
API_PORT=8787
# Dossier de persistance de l'hôpital simulé (JSON). Vide = mémoire seule.
DATA_DIR=.data
# Scénario chargé au premier démarrage (voir `pnpm sim list`) : chir-bino = démo du front Bino.
DEFAULT_SCENARIO=chir-bino
# Au premier démarrage : end = journée rejouée jusqu'au bout (démo prête), start = laissée au début.
SIM_BOOT=end
# Connexion de démo : matricule d'un soignant du scénario + ce mot de passe partagé
# (casse et espaces ignorés). Pas une authentification réelle (CPS / e-CPS en V2).
DEMO_PASSWORD=bino

# ─── LLM : structuration DAR, admission ─────────────────────────────────────
# heuristic | deepseek | openai | anthropic | mistral | google | openai-compatible
#   openai-compatible couvre : Ollama, vLLM, LM Studio, OVHcloud AI Endpoints,
#   Scaleway Generative APIs, Groq, Together… (renseigner LLM_BASE_URL)
LLM_PROVIDER=heuristic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=45000
# Si le fournisseur échoue : on bascule sur le moteur local (mode dégradé signalé dans l'UI).
LLM_FALLBACK=heuristic

# Exemple DeepSeek :
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

# ─── Speech-to-text côté serveur (optionnel) ────────────────────────────────
# none | openai | groq | openai-compatible
#   Sans STT serveur : l'app utilise la reconnaissance vocale du navigateur (web)
#   ou la dictée du clavier du téléphone.
#   openai-compatible : faster-whisper-server / speaches auto-hébergé (piste HDS).
STT_PROVIDER=none
# Texte FINAL de la dictée (fichier entier). Avec openai, recommandé : gpt-transcribe
# (le plus juste, nombres en chiffres). Défaut openai : whisper-1.
STT_MODEL=
STT_API_KEY=
STT_BASE_URL=
# Dictée en direct (texte provisoire pendant qu'on parle, WebSocket /transcriptions/live) :
# activée d'office quand STT_PROVIDER=openai, avec la même clé STT_API_KEY. À l'arrêt, tout
# l'enregistrement est retranscrit avec STT_MODEL et remplace le provisoire.
# Défaut : gpt-live-transcribe ; « none » pour désactiver (l'app enregistre puis transcrit).
STT_LIVE_MODEL=

# ─── Classifieur (rattachement patient, gravité des cibles) ─────────────────
# heuristic | llm | jev
CLASSIFIER_PROVIDER=heuristic
# TypeSafe / Jev (https://docs.typesafe.ai)
JEV_API_KEY=
JEV_MODEL=jev-latest

# ─── App mobile (Expo) ──────────────────────────────────────────────────────
# URL de l'API vue depuis l'app. Laisse vide : l'app devine l'IP de ta machine
# (même Wi-Fi que le téléphone) en mode développement.
EXPO_PUBLIC_API_URL=
