{
  "name": "@infirmier/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Hono : services métier, hôpital simulé persistant, pipeline IA, simulateur et CLI.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "vitest run",
    "sim": "node --env-file-if-exists=../../.env --import tsx src/cli/sim.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@infirmier/ai": "workspace:*",
    "@infirmier/domain": "workspace:*",
    "@infirmier/simulation": "workspace:*",
    "hono": "^4.13.18",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
