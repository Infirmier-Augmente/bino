{
  "name": "bino",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-14",
  // L'app statique est servie par le Worker ; /api/* passe par le code (stockage commun + IA).
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  // Stockage commun de la démo : un seul Durable Object (SQLite) pour tout le service.
  "durable_objects": { "bindings": [{ "name": "WARD", "class_name": "Ward" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ward"] }],
  // Secrets à définir côté Cloudflare (jamais dans le repo) : ANTHROPIC_API_KEY, RESET_CODE.
  "vars": { "AI_MODEL": "claude-sonnet-5-5", "AI_DAILY_LIMIT": "400" }
}
