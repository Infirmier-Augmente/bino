{
  "name": "bino",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-14",
  // L'app statique est servie par le Worker. /api/bino est relayé vers le mini.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  // L'ancien stockage commun (Durable Object « Ward ») n'est plus utilisé.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ward"] },
    { "tag": "v2", "deleted_classes": ["Ward"] }
  ],
  // Secret côté Cloudflare, jamais dans le repo : API_EDGE_SECRET.
  // API_ORIGIN est l'adresse du tunnel.
  "vars": {
    "API_ORIGIN": "https://bino-api.spidex.dev"
  }
}
