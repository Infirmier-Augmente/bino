{
  "name": "infirmier-augmente",
  "private": true,
  "description": "Infirmier augmenté : dictée au fil de l'eau, transmissions DAR sourcées et relève priorisée (hackathon IA santé, défi Foch).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@infirmier/api --filter=@infirmier/mobile",
    "dev:api": "pnpm --filter @infirmier/api dev",
    "dev:app": "pnpm --filter @infirmier/mobile start",
    "dev:web": "pnpm --filter @infirmier/mobile web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @infirmier/e2e e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "sim": "pnpm --silent --filter @infirmier/api sim",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  }
}
